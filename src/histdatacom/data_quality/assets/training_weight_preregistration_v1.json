  "policies": [
    {
      "id": "observed-only.v1",
      "mass": "W_h over retained degraded observed rows; full-parent truth is never training input"
    },
    {
      "id": "equal-unit-mass.v1",
      "mass": "W_h/M_h per admitted member; each member's rows normalized to sum to its member mass"
    },
    {
      "id": "one-member-per-epoch.v1",
      "selection": "int(SHA256(canonical_json([policy_id,historical_unit_id,training_epoch])),16) modulo number_of_canonically_sorted_admitted_members",
      "mass": "W_h to selected member; member row normalization",
      "epochs": [
        0,
        1,
        2,
        3
      ]
    },
    {
      "id": "member-marginalized-loss.v1",
      "loss": "W_h*arithmetic_mean(member_loss); actual callback API required; never loss_of_mean_prediction"
    },
    {
      "id": "calibrated-capped-radius.v1",
      "a": "1/(1+max_symbol(radius/pip_size))",
      "b": "max(a/max_member(a),1/4)",
      "mass": "W_h*b/sum_member(b)",
      "maximum_within_unit_member_ratio": 4,
      "row_normalization": "member_mass divided by exact complete retained member row count",
      "filtering": "retain-original-weights; no-renormalization"
    },
    {
      "id": "naive-concatenation-negative-control.v1",
      "mass": "W_h per member,not divided by M_h",
      "required_state": "failed-negative-control-for-M_h>1",
      "eligible_as_default": false
    }
  ],
  "evaluation": {
    "application_allocation_order": "persist-all-policy-allocations-before-any-application-truth-error-or-comparison",
    "point_loss": "mean_{symbol,probe}(abs(candidate_mid-reference_mid)/pip_size)",
    "observed_only_predictor": "bounded-prior-degraded-observed-quote-at-identical-probes",
    "member_marginalization": "mean-of-member-losses-not-loss-of-mean-path",
    "minimum_application_units_for_inference": 20,
    "minimum_complete_policy_common_units": 20,
    "radius_coverage_reporting": "report pre-domain-filter coverage on every fully evaluable application unit and admitted-subset coverage separately, each with exact numerator, denominator, unit IDs and refusal counts; undefined radius or missing truth is unavailable, never counted as covered",
