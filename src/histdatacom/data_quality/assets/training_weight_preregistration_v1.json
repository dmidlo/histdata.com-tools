      "radius-widths-and-joint-observed-coverage",
      "paired-unit-losses",
      "cluster-CI-and-significance-assumptions",
      "source-model-adapter-and-calibration-identities"
    ],
    "kish": "(sum_row_weights)^2/sum_squared_row_weights; concentration-not-correlation; unavailable-for-zero-mass",
    "correlation": {
      "features": "member fixed-grid pip-normalized midpoint increments concatenated within each unit over three symbols",
      "matrix": "Pearson-correlation-across-member-feature-vectors",
      "participation_ratio": "trace(C)^2/trace(C@C); denominator=sum_ij(C_ij^2) for symmetric C; @ is matrix multiplication, not elementwise product",
      "constant_vector": "unavailable-not-invented-zero-correlation",
      "diagnostic_only": true
    },
