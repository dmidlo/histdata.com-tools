  "uncertainty": {
    "quantity": "fixed-model-joint-triangle-member-midpoint-error-radius",
    "confidence_interpretation": "nominal-pre-abstention-marginal-coverage-under-conditional-on-fixed-model-day-exchangeability-only; not conditional on an admitted subset or a realized calibration sample",
    "nominal_coverage": 0.9,
    "minimum_calibration_units": 30,
    "calibration_unit_score": "max_{symbol,member}(max_probe(abs(candidate_mid-reference_mid))/available_scale)",
