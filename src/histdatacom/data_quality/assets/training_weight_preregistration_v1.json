      "method": "exact-two-sided-paired-unit-sign-test",
      "null": "independent-unit-positive-negative-sign-probability-one-half",
      "ties": "omit-zero-differences-and-report-effective-n",
      "familywise_method": "Holm",
      "fixed_family_size": 7,
      "fixed_family_coordinates": [
        "observed-only.v1-minus-equal-unit-mass.v1",
        "one-member-per-epoch.v1:epoch=0-minus-equal-unit-mass.v1",
        "one-member-per-epoch.v1:epoch=1-minus-equal-unit-mass.v1",
        "one-member-per-epoch.v1:epoch=2-minus-equal-unit-mass.v1",
        "one-member-per-epoch.v1:epoch=3-minus-equal-unit-mass.v1",
        "member-marginalized-loss.v1-minus-equal-unit-mass.v1",
        "calibrated-capped-radius.v1-minus-equal-unit-mass.v1"
      ],
      "family_exclusions": [
        "equal-unit-mass.v1-minus-itself",
        "naive-concatenation-negative-control.v1"
      ],
      "unavailable_coordinate_rule": "retain coordinate with null reported p-value; use p=1 only inside Holm arithmetic and retain family size 7; never remove a coordinate or substitute an observed outcome",
      "alpha": 0.05
    },
    "inference_nonclaim": "unit clustering prevents sibling pseudo-replication but does not prove serial-day independence or eliminate regime drift; intervals are conditional descriptive diagnostics",
    "required_reports": [
      "scheduled-refused-admitted-day-counts",
